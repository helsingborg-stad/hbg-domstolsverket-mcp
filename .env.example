DOMSTOLSVERKET_MCP_API_BASE_URL=https://rattspraxis.etjanst.domstol.se
DOMSTOLSVERKET_MCP_API_TIMEOUT_SECONDS=30
DOMSTOLSVERKET_MCP_HOST=0.0.0.0
DOMSTOLSVERKET_MCP_PORT=8000
DOMSTOLSVERKET_MCP_MCP_PATH=/mcp
# Set to require `Authorization: Bearer <key>` on the MCP path. Leave unset to disable auth.
DOMSTOLSVERKET_MCP_API_KEY=

# Used only by docker-compose.yml (Traefik TLS). Subdomain must resolve to this VM's IP.
DOMAIN=domstol-mcp.example.com
ACME_EMAIL=admin@example.com
