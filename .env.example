DOMSTOLSVERKET_MCP_API_BASE_URL=https://rattspraxis.etjanst.domstol.se
DOMSTOLSVERKET_MCP_API_TIMEOUT_SECONDS=30
DOMSTOLSVERKET_MCP_HOST=0.0.0.0
DOMSTOLSVERKET_MCP_PORT=8000
DOMSTOLSVERKET_MCP_MCP_PATH=/mcp
DOMSTOLSVERKET_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
DOMSTOLSVERKET_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Required. The MCP path enforces `Authorization: Bearer <key>`; the server refuses to start if unset.
# This is a throwaway local value — set a strong, unique key in any real deployment.
DOMSTOLSVERKET_MCP_API_KEY=dev-local-key

# Used only by docker-compose.yml (Traefik TLS). Subdomain must resolve to this VM's IP.
DOMAIN=domstol-mcp.example.com
ACME_EMAIL=admin@example.com
